# ─── Configuración del servidor ─────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MySQL ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=magnetmonitor
DB_POOL_SIZE=10

# ─── Seguridad ───────────────────────────────────────────────────
# La API del ESP32 valida esta cabecera: X-API-Key
# Debes registrar cada sensor con su propia api_key en la tabla sensors
ADMIN_KEY=cambia_esto_por_una_clave_segura

# ─── CORS ────────────────────────────────────────────────────────
# Orígenes permitidos para el frontend (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
